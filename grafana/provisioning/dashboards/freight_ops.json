    },
    {
      "id": 5,
      "title": "Daily dispatched vs delivered late",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "freight-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "freight-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select day::timestamp as time, dispatched, delivered, delivered_late from marts.mart_daily_ops where $__timeFilter(day::timestamp) order by 1"
        }
