          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select transporter, shipments, on_time_pct, overbilled_pct, overbilled_amount, invoices_with_errors, delivered_not_invoiced from marts.mart_transporter_scorecard order by overbilled_amount desc"
