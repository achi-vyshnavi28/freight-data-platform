  "panels": [
    {
      "id": 1,
      "title": "On-time delivery %",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "freight-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "freight-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select round(100.0 * avg(case when on_time then 1 else 0 end), 1) as on_time_pct from marts.fct_shipments where on_time is not null and $__timeFilter(delivered_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Overbilled (INR)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "freight-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "freight-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select coalesce(sum(freight_variance), 0) as overbilled from marts.fct_shipments where is_overbilled and $__timeFilter(dispatched_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Delivered, not invoiced",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "freight-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "freight-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select count(*) as cases from marts.mart_revenue_leakage where issue = 'delivered, never invoiced'"
        }
      ]
    },
    {
      "id": 4,
      "title": "Rows quarantined (last run)",
